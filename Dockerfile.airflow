FROM apache/airflow:2.10.4-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

USER airflow
RUN pip install --no-cache-dir \
    "beautifulsoup4>=4.15.0,<5" \
    "boto3>=1.43.122,<2" \
    "dbt-duckdb>=1.11.1,<2" \
    "duckdb>=2.0.0,<3" \
    "fastembed>=0.4.0,<1" \
    "flashrank>=0.2.10,<1" \
    "httpx>=0.28.1,<1" \
    "langgraph>=1.2.21,<2" \
    "lxml>=6.1.3,<7" \
    "openai>=3.49.0,<4" \
    "pyarrow>=26.0.1,<27" \
    "pydantic>=2.14.1,<3" \
    "python-dotenv>=1.0.0,<2" \
    "pyyaml>=6.0.3,<7" \
    "qdrant-client>=1.12.0,<2" \
    "tenacity>=9.2.1,<10" \
    "tiktoken>=0.14.0,<1" \
    && python -c "import duckdb; c = duckdb.connect(':memory:'); c.execute('INSTALL httpfs; LOAD httpfs;')"
