# SEC EDGAR Ingestion Settings
# SEC requires format: Sample Company Name AdminContact@<sample company domain>.com
SEC_USER_AGENT=CorporateFilingIntelligence user@example.com
SEC_RATE_LIMIT_PER_SEC=10

# Paths
DATA_DIR=/app/data
MODELS_DIR=/app/models

# LLM Settings (Task 11.1)
# LLM_MAX_ATTEMPTS represents total call attempts including the initial attempt.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3


# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Market Data Settings (Task 17.4)
FINNHUB_API_KEY=
