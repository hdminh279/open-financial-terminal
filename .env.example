# SEC EDGAR Ingestion Settings
# SEC requires format: Sample Company Name AdminContact@<sample company domain>.com
SEC_USER_AGENT=CorporateFilingIntelligence user@example.com
SEC_RATE_LIMIT_PER_SEC=10

# Paths
DATA_DIR=/app/data
MODELS_DIR=/app/models

# LLM Settings
# LLM_MAX_ATTEMPTS represents total call attempts including the initial attempt.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3


# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Market Data Settings
FINNHUB_API_KEY=

# Production Security & Deployment
APP_ENV=local
ALLOWED_ORIGINS=https://your-domain.example.com
SESSION_COOKIE_SECRET=
QUERY_RATE_LIMIT_PER_MIN=15
QUERY_RATE_BURST=5
API_RATE_LIMIT_PER_MIN=60
API_RATE_BURST=20
S3_ACCESS_KEY=
S3_SECRET_KEY=
CLOUDFLARE_TUNNEL_TOKEN=

# Apache Airflow Automation (Oracle Cloud VM)
AIRFLOW_PG_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
